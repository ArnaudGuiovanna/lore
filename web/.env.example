# LORE backend base URL (server-side only)
LORE_BASE=http://127.0.0.1:8080
# Operator bootstrap secret — MUST match the backend's LORE_BOOTSTRAP_TOKEN.
# The Next server uses it to mint per-user LORE tokens after verifying passwords.
LORE_BOOTSTRAP_TOKEN=change-me-operator-secret
# Secret used to sign session cookies (>= 32 bytes).
SESSION_SECRET=change-me-session-secret-at-least-32-bytes-long
# Default password for the seeded demo accounts (change in production).
DEFAULT_SEED_PASSWORD=lore123!
# Show the seeded demo accounts + password on the login page. OFF by default.
# Set to 1 ONLY for demo/evaluation deployments — never in production.
LORE_SHOW_DEMO_LOGINS=0
# Credential store backing (passwords + login email -> LORE user id mapping).
#   - UNSET (default): file-backed JSON at web/.gen/users.json. Zero-config,
#     single-node, ideal for local dev. Survives restart only on a persisted volume.
#   - SET: durable Postgres backing. Passwords live in a `lore_web_credentials`
#     table (auto-created on first use); logins survive restarts and scale beyond
#     one node. Point this at your Postgres instance to make the store durable.
# DATABASE_URL=postgres://lore:lore@127.0.0.1:5432/lore

# --- Email (invitations & notifications) -----------------------------------
# If ALL of SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS/SMTP_FROM are set, invitation
# emails (temp password + login link) are sent via SMTP. If any is missing, the
# mailer falls back to logging the message to the server console (dev outbox), so
# invitation links/passwords are still visible during local development.
# Port 465 uses implicit TLS; other ports negotiate STARTTLS when available.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=change-me
# SMTP_FROM=LORE <no-reply@example.com>
# Public base URL of the app (e.g. https://lms.your-of.fr). Used for links in
# emails (invitations) — NEVER derived from the request host. Set in production.
PUBLIC_APP_URL=
