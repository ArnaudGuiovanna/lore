# LORE reverse proxy.
#
# DOMAIN is injected by docker compose from deploy/.env:
#   - Set DOMAIN=lore.example.org  -> Caddy serves HTTPS with an automatic
#     Let's Encrypt certificate (ports 80/443) and redirects HTTP -> HTTPS.
#   - Leave DOMAIN empty (default)  -> Caddy serves plain HTTP on :80, which is
#     handy for local / no-domain testing. You can also hit the web app directly
#     on http://localhost:3001 in that case.
#
# Caddy substitutes {$DOMAIN:...} with the env var (or the default after the colon
# when the variable is empty). All proxying targets the internal `web` service.

{$DOMAIN::80} {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; form-action 'self'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy web:3001
}
