# LORE production stack — environment template.
#
# Copy to deploy/.env and fill in real values, OR just run ./deploy/up.sh which
# generates deploy/.env from this file with strong random secrets for you.
#
# Generate a secret manually with:
#   openssl rand -hex 32     # for *_SECRET, *_PASSWORD and LORE_METRICS_TOKEN
#   openssl rand -hex 24     # for LORE_BOOTSTRAP_TOKEN
#
# NEVER commit deploy/.env. Keep it 0600 and back it up somewhere safe.

# --- Postgres (durable store for the backend) -------------------------------
# Superuser used only for database initialization/maintenance.
POSTGRES_SUPERUSER=postgres
POSTGRES_DB=lore
# REQUIRED. openssl rand -hex 32
POSTGRES_SUPERUSER_PASSWORD=
# Non-superuser application role. This is the only DB role used by LORE services.
LORE_DB_USER=lore
# REQUIRED. openssl rand -hex 32
LORE_DB_PASSWORD=

# --- Backend (LORE Go API) --------------------------------------------------
# REQUIRED. Signs per-user JWTs. >= 32 bytes. openssl rand -hex 32
JWT_SECRET=
# REQUIRED. Gates membership creation + token minting; MUST match the web app.
# openssl rand -hex 24
LORE_BOOTSTRAP_TOKEN=
# REQUIRED in production. Protects Prometheus GET /metrics.
# Use as Authorization: Bearer <token> or X-LORE-Metrics-Token.
# openssl rand -hex 32
LORE_METRICS_TOKEN=
# Optional LLM wiring. instruction_only runs the runtime without any LLM.
LORE_LLM_PROVIDER=instruction_only
LORE_LLM_MODEL=tenant-runtime

# --- Web (Next.js LECTURE front) --------------------------------------------
# REQUIRED. Signs the session cookie. >= 32 bytes. openssl rand -hex 32
SESSION_SECRET=
# Password for the first-run seeded demo accounts. CHANGE for any real use,
# and have users reset it after first login.
DEFAULT_SEED_PASSWORD=lore123!
# Keep 0 in production: do NOT render seeded demo credentials on the login page.
LORE_SHOW_DEMO_LOGINS=0

# --- TLS / reverse proxy ----------------------------------------------------
# Set to your public hostname (with a DNS record pointing at this host) to get
# automatic HTTPS via Let's Encrypt. Leave EMPTY for local/no-domain HTTP on :80.
DOMAIN=
